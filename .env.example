# Gateway (API authentication)
# Protects /api/v1/encrypt-image. Clients must send this key via
# the "X-API-Key" header or "Authorization: Bearer <key>".
# Generate a strong random key for production, e.g.:
#   openssl rand -hex 32
GATEWAY_API_KEY=change-me-to-a-long-random-secret

# Encryption Service
SECRET_KEY=supersecret16bytes
UHC_MATRIX_SIZE=16
UHC_PASSWORD2=7391
DB_PATH=/data/logs.db

# Internal service URLs (gateway uses these)
FEATURE_SERVICE_URL=http://feature-service:8081
SELECTOR_SERVICE_URL=http://selector-service:8082
ENCRYPTION_SERVICE_URL=http://encryption-service:8083

# --- Experiment instrumentation (paper chapter 4 data) ---
# Set to true ONLY on staging/experiment deployments to enable the internal
# X-Experiment-Force-Method header (UHC/Blowfish/Hybrid UHC-Blowfish/adaptive).
# Production default is false; the endpoint always uses the AI Selector.
EXPERIMENT_MODE=false
# Per-service SQLite experiment DB path (mounted via docker-compose volumes)
EXPERIMENT_DB_PATH=/experiment/experiment_logs.db
# Gateway JSONL access log (end-to-end latency + errors)
GATEWAY_EXPERIMENT_LOG=/experiment/gateway_experiment.jsonl
